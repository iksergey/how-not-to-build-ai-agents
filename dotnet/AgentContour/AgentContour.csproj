<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentContour</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Те же пакеты, что в курсе: клиент OpenAI-совместимого API (им же ходим в Ollama)
         и Microsoft Agent Framework, из которого здесь нужны AIFunction, ChatMessage и IChatClient -->
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.16.0" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
  </ItemGroup>
</Project>
